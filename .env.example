# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control.

# ===== DATABASE =====
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finance-manager

# ===== AUTHENTICATION =====
# Generate a strong random string (at least 32 characters): openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===== ONESIGNAL (server-side, for push notifications) =====
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ===== ONESIGNAL (exposed to browser) =====
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# ===== VERCEL CRON =====
# Protects /api/cron/reminders. Generate with: openssl rand -base64 32
# Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# ===== FRONTEND API BASE (optional) =====
# Only needed if the API is hosted on a different origin than the frontend.
# If not set, the frontend uses same-origin "/api".
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
